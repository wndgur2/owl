# Normalize line endings: text files are stored and checked out with LF.
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never diff or convert
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.jar binary
*.pdf binary
*.hex binary
*.bin binary
*.ogg binary
*.opus binary
*.wav binary
