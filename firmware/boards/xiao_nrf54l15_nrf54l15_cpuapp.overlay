/*
 * Owl wiring on XIAO nRF54L15 Sense (see hardware/wiring.md).
 * Zephyr picks this file up automatically for board xiao_nrf54l15/nrf54l15/cpuapp.
 *
 *   W25Q128 SPI flash : D8 SCK, D9 MISO, D10 MOSI (xiao_spi = spi00), D3 CS
 *   Master button     : D1 -> GND, internal pull-up
 *   Battery voltage   : AIN7 via vbat_pwr load switch, divider 1/2 (board dts)
 */

/ {
	zephyr,user {
		io-channels = <&adc 7>;
		master-button-gpios = <&xiao_d 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};

	aliases {
		ext-flash = &w25q128;
		/* The board only names it dmic20. */
		dmic0 = &pdm20;
	};
};

&xiao_spi {
	status = "okay";
	cs-gpios = <&xiao_d 3 GPIO_ACTIVE_LOW>;

	w25q128: w25q128@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <8000000>;
		/* size is in bits: 128 Mbit = 16 MiB */
		size = <0x8000000>;
		/* W25Q128JV-IQ/JQ. If bring-up reports EF 70 18, it is the -IM variant: update this. */
		jedec-id = [ef 40 18];
		has-dpd;
		t-enter-dpd = <3000>;
		t-exit-dpd = <3000>;
	};
};
