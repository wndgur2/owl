/* 1 MiB of the 2 MiB simulated flash for /lfs, same LittleFS settings as the board. */
&flash0 {
	partitions {
		lfs_partition: partition@100000 {
			label = "owl-storage";
			reg = <0x00100000 0x00100000>;
		};
	};
};

/ {
	fstab {
		compatible = "zephyr,fstab";

		owl_lfs: owl_lfs {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&lfs_partition>;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <512>;
			lookahead-size = <64>;
			block-cycles = <512>;
		};
	};
};
